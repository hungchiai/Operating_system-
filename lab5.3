#include <stdio.h>

int main() {
    // 固定測資
    int n = 3;  // 行程數量
    int AT[] = {0, 0, 0};  // 到達時間
    int BT[] = {4, 3, 5};  // 執行時間
    int q = 2;  // 時間量子
   
    // 複製BT到remaining_time以追蹤剩餘時間
    int remaining_time[3];
    for (int i = 0; i < n; i++) {
        remaining_time[i] = BT[i];
    }
   
    int time = 0;  // 當前時間
    int context_switch_count = 0;  // Context Switch計數
    int current_process = -1;  // 當前執行的行程 (-1表示尚未開始)
    int completed = 0;  // 已完成的行程數
   
    // Round Robin 排程
    while (completed < n) {
        int found = 0;  // 是否找到可執行的行程
       
        for (int i = 0; i < n; i++) {
            // 檢查行程是否已到達且尚未完成
            if (AT[i] <= time && remaining_time[i] > 0) {
                found = 1;
               
                // 計算此次要執行的時間
                int execute_time;
                int original_remaining = remaining_time[i];
               
                if (remaining_time[i] > q) {
                    execute_time = q;
                    remaining_time[i] -= q;
                } else {
                    execute_time = remaining_time[i];
                    remaining_time[i] = 0;
                    completed++;
                }
               
                // 輸出執行資訊
                printf("t=%d 執行 P%d → 執行單位 (原剩%d → 現剩%d)\n",
                       time, i + 1, original_remaining, remaining_time[i]);
               
                time += execute_time;
               
                // 檢查是否需要進行Context Switch
                // 只有在還有未完成的行程時才計算Context Switch
                if (completed < n) {
                    // 尋找下一個可執行的行程
                    int next_process = -1;
                    for (int j = (i + 1) % n; j != i; j = (j + 1) % n) {
                        if (AT[j] <= time && remaining_time[j] > 0) {
                            next_process = j;
                            break;
                        }
                    }
                   
                    // 如果找到下一個行程且與當前行程不同
                    if (next_process != -1 && next_process != i) {
                        context_switch_count++;
                        printf("Context Switch +1 → P%d\n", next_process + 1);
                    } else if (remaining_time[i] > 0) {
                        // 如果當前行程還沒完成且沒有其他行程，繼續執行
                        continue;
                    }
                }
               
                break;  // 跳出for循環，重新開始選擇行程
            }
        }
       
        // 如果沒有找到可執行的行程，時間推進
        if (!found) {
            time++;
        }
    }
   
    printf("Total Context Switch = %d\n", context_switch_count);
   
    return 0;
}
