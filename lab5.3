#include <stdio.h>

int main() {
    int n = 3;
    int AT[] = {0, 0, 0};
    int BT[] = {4, 3, 5};
    int q = 2;

    int remaining_time[3];
    for (int i = 0; i < n; i++) {
        remaining_time[i] = BT[i];
    }

    int time = 0;
    int context_switch_count = 0;
    int completed = 0;

    int current = 0;      
    int prev = -1;       

    while (completed < n) {
        int found = 0;

  
        for (int step = 0; step < n; step++) {
            int i = (current + step) % n;

            if (AT[i] <= time && remaining_time[i] > 0) {
                found = 1;

                int original_remaining = remaining_time[i];
                int execute_time;

                if (remaining_time[i] > q) {
                    execute_time = q;
                    remaining_time[i] -= q;
                } else {
                    execute_time = remaining_time[i];
                    remaining_time[i] = 0;
                    completed++;
                }

                
                if (prev != -1 && prev != i) {
                    context_switch_count++;
                    printf("Context Switch +1 → P%d\n", i + 1);
                }

                printf("t=%d 執行 P%d → 執行%d單位 (原剩%d → 現剩%d)\n",
                       time, i + 1, execute_time, original_remaining, remaining_time[i]);

                time += execute_time;
                prev = i;
                current = (i + 1) % n;  

                break;  
            }
        }

     
        if (!found) {
            time++;
        }
    }

    printf("\nTotal Context Switch = %d\n", context_switch_count);

    return 0;
}
