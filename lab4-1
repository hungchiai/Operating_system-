#include <pthread.h>
#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

typedef struct {
    long long sum;
} CalcResult;

// Check if a number is prime
bool is_prime(int n) {
    if (n <= 1) return false;
    if (n <= 3) return true;
    if (n % 2 == 0 || n % 3 == 0) return false;
    for (int i = 5; i * i <= n; i += 6) {
        if (n % i == 0 || n % (i + 2) == 0)
            return false;
    }
    return true;
}

void *sum_all_numbers(void *arg) {
    CalcResult *result = (CalcResult *)arg;
    result->sum = 0;
    for (int i = 1; i <= 10000; i++) {
        result->sum += i;
    }
    printf("[Thread 1] Sum of 1 to 10000 = %lld\n", result->sum);
    pthread_exit(NULL);
}

void *sum_prime_numbers(void *arg) {
    CalcResult *result = (CalcResult *)arg;
    result->sum = 0;
    for (int i = 1; i <= 10000; i++) {
        if (is_prime(i)) {
            result->sum += i;
        }
    }
    printf("[Thread 2] Sum of primes from 1 to 10000 = %lld\n", result->sum);
    pthread_exit(NULL);
}

int main() {
    pthread_t thread_a, thread_b;
    CalcResult result_a, result_b;
   
    // Create threads
    pthread_create(&thread_a, NULL, sum_all_numbers, &result_a);
    pthread_create(&thread_b, NULL, sum_prime_numbers, &result_b);
   
    // Wait for threads to complete
    pthread_join(thread_a, NULL);
    pthread_join(thread_b, NULL);
   
    printf("All calculations are completed.\n");
   
    return 0;
}
